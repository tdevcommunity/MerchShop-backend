APP_NAME=MerchShop
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

LOG_CHANNEL=stack
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=merchshop
DB_USERNAME=merchshop
DB_PASSWORD=

CACHE_STORE=redis
CACHE_PREFIX=

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

SESSION_DRIVER=cookie
SESSION_LIFETIME=120

QUEUE_CONNECTION=sync

MAIL_MAILER=log

L5_SWAGGER_GENERATE_ALWAYS=true
L5_SWAGGER_CONST_HOST=http://localhost:8000

# Cle publique Velto (pk_sandbox_* ou pk_live_*), reference / whitelist portail
VELTO_PUBLIC_KEY=
# Cle API gate : sk_* de preference ; pk_* comme en sandbox (VELTO_WEB_ORIGIN obligatoire)
VELTO_SECRET_KEY=
VELTO_BASE_URL=https://velto-gate.kiiako.io/v1
# Origine HTTP du frontend pour Velto (cle pk_*). Whitelist Applications > Securite
# Local : http://localhost:3000 — Prod : https://shop.ourtdev.com
# VELTO_WEB_ORIGIN=http://localhost:3000
# Secret pour verifier X-Velto-Signature (souvent la meme cle que VELTO_SECRET_KEY)
PAYMENT_WEBHOOK_SECRET_VELTO=
VELTO_DEFAULT_WITHDRAWAL_OPERATOR=mtn_open
# Sandbox uniquement : pays MM par defaut (Momo Test Benin : bj, numero 64000001)
VELTO_CHECKOUT_PHONE_COUNTRY=bj
# Optionnel sandbox : email kodjo+ref@... pour eviter profil FedaPay memorise (defaut : false)
# VELTO_SANDBOX_UNIQUE_CUSTOMER_EMAIL=false

# Origines frontend autorisees par l'API (virgules). Defaut : http://localhost:3000
# CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Prod : CORS_ALLOWED_ORIGINS=https://shop.ourtdev.com

PAYMENT_PROVIDER=velto

# Adresse de retour apres tentative de reglement chez l'operateur. Elle est
# lue par config/payments.php et transmise telle quelle a Velto. Elle doit
# pointer vers la page de retour du frontend, qui relit la commande en attente
# puis attend la confirmation du webhook.
#
# Local :
# Sandbox : http://localhost:3000/checkout/payment-return
# Live (cles pk_live_*) : HTTPS obligatoire, ex. https://shop.ourtdev.com/checkout/payment-return
#
# Production (shop.ourtdev.com) :
# PAYMENT_RETURN_URL=https://shop.ourtdev.com/checkout/payment-return
#
# Webhook Velto a enregistrer dans le dashboard (Developpeurs > Webhooks) :
# https://shop-api.ourtdev.com/api/v1/payments/webhooks/velto
#
# Whitelist domaines Velto (Applications) : shop.ourtdev.com et shop-api.ourtdev.com
PAYMENT_RETURN_URL=http://localhost:3000/checkout/payment-return

# Jeton invité commande (QR retrait + lecture commande sans compte). Min. 32 caracteres en prod.
PICKUP_TOKEN_SECRET=

# Cloudinary — upload automatique des images produits
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_URL=
CLOUDINARY_FOLDER=merch-shop/products
