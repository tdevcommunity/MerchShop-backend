APP_NAME=MerchShop
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

LOG_CHANNEL=stack
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=merchshop
DB_USERNAME=merchshop
DB_PASSWORD=

CACHE_STORE=redis
CACHE_PREFIX=

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

SESSION_DRIVER=cookie
SESSION_LIFETIME=120

# La confirmation de commande apres paiement part par ce canal : le job
# SendOrderConfirmationEmail est mis en file et execute selon ce driver.
# En sync l'envoi se fait dans le appelant ; en production, un driver reel
# (redis, database) evite d'allonger la reponse du webhook d'attente SMTP.
QUEUE_CONNECTION=sync

# Envoi des emails (confirmation de commande apres paiement).
# `log` ecrit le message dans storage/logs : inoffensif pour developper.
# Pour un envoi reel, passer sur `smtp` et renseigner les champs ci-dessous.
MAIL_MAILER=log
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
# Expediteur visible par le client : c'est lui qui figure en "De".
MAIL_FROM_ADDRESS=commandes@example.com
MAIL_FROM_NAME="${APP_NAME}"

L5_SWAGGER_GENERATE_ALWAYS=true
L5_SWAGGER_CONST_HOST=http://localhost:8000

FEDAPAY_PUBLIC_KEY=
FEDAPAY_SECRET_KEY=
FEDAPAY_ENVIRONMENT=sandbox
# Secret affiché dans FedaPay > Tableau de bord > Paramètres > Webhooks
PAYMENT_WEBHOOK_SECRET_FEDAPAY=
FEDAPAY_WEBHOOK_TOLERANCE=300

PAYMENT_PROVIDER=fedapay

# Adresse de retour apres tentative de reglement chez l'operateur. Elle est
# lue par config/payments.php et transmise telle quelle a FedaPay. Elle doit
# pointer vers la page de retour du frontend, qui relit la commande en attente
# puis attend la confirmation du webhook.
PAYMENT_RETURN_URL=http://localhost:3000/checkout/payment-return

# Cloudinary — upload automatique des images produits
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_URL=
CLOUDINARY_FOLDER=merch-shop/products
